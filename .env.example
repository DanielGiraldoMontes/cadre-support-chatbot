# Supabase (browser + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. conversations/messages/escalations/rate_limits have no
# per-user RLS policy (there's no user auth in this app), so RLS denies the
# public/publishable key by default and the service role is used instead —
# never sent to the browser, never NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (server-only — never expose as NEXT_PUBLIC_*)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Used only by the Step 2 semantic fallback (CLAUDE.md Section 9) — same
# OPENROUTER_API_KEY above, no second credential.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Local development only — never set in Firebase secrets/production.
# When true, the app uses the in-repo mock provider instead of calling
# OpenRouter, so UI/routing/persistence/rate-limiting can be tested for free.
USE_MOCK_LLM=false
